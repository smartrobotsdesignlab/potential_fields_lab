Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /MarkerArray1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 160
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Keep: 100
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Color: 60; 180; 75
        Alpha: 0.6
        Shaft Length: 0.15
        Shaft Radius: 0.02
        Head Length: 0.06
        Head Radius: 0.04
    - Class: rviz_default_plugins/MarkerArray
      Name: MarkerArray
      Enabled: true
      Topic:
        Value: /pf2d_markers
        Depth: 10
        Reliability Policy: Reliable
        History Policy: Keep Last
      Namespaces:
        pf2d: true
    - Class: rviz_default_plugins/Path
      Name: RobotPath
      Enabled: true
      Topic:
        Value: /pf2d_path
        Depth: 10
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color: 31; 158; 137
      Alpha: 1
      Line Style: Lines
      Line Width: 0.03
      Buffer Length: 1
      Pose Style: None
  Global Options:
    Fixed Frame: odom
    Background Color: 255; 255; 255
    Frame Rate: 30
  Fixed Frame: odom
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: odom
      Scale: 180
      X: 1.0
      Y: 0.0
      Angle: 0
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Hide Left Dock: false
  Hide Right Dock: false
